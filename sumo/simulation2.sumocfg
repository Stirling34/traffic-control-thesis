<configuration>
    <input>
        <net-file value="net\plain.net2.xml"/>
        <route-files value="routes\route.rou2.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="1000"/>
    </time>

    <gui_only>
        <delay value="10"/>
    </gui_only>

    <report>
        <verbose value="true"/>
        <no-step-log value="true"/>
    </report>

    <output>
        <!-- fcd-output removed 2026-08-18: it wrote ~30 MB on every run
             and nothing read it. Enable per-run on the command line when
             per-vehicle trajectories are actually wanted (TET/TIT). -->
    </output>
</configuration>